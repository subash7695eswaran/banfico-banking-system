{
  "id": "banfico-realm",
  "realm": "banfico-realm",
  "displayName": "Banfico Open Banking Realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator with system-wide configuration and audit access (does not bypass consent)"
      },
      {
        "name": "customer",
        "description": "Customer / Data Owner: Views own accounts, approves, rejects, and revokes data sharing consents"
      },
      {
        "name": "consent_requester",
        "description": "Consent Requester / Data Consumer (TPP FinTech): Requests consent and queries authorized banking data"
      },
      {
        "name": "bank_provider",
        "description": "Bank / Data Provider: Maintains accounts and delivers data strictly validated against active consents"
      },
      {
        "name": "consent_manager",
        "description": "Consent Manager: Oversees full consent lifecycle state machine, validation rules, and audit logging"
      },
      {
        "name": "maker",
        "description": "Banking Operations Maker: Initiates banking transactions, transfers, and account operations"
      },
      {
        "name": "checker",
        "description": "Banking Operations Checker: Reviews and authorises high-value or sensitive operations initiated by Maker"
      }
    ]
  },
  "clients": [
    {
      "clientId": "banfico-banking-app",
      "name": "Banfico Mini Banking Frontend / API",
      "description": "Client for Banfico Banking Application",
      "rootUrl": "http://localhost:5173",
      "adminUrl": "http://localhost:5173",
      "baseUrl": "/",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "banfico-backend-api",
      "name": "Banfico Spring Boot Resource Server",
      "bearerOnly": true,
      "enabled": true,
      "protocol": "openid-connect"
    }
  ],
